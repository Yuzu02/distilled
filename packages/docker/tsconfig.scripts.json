{
  "extends": "../../tsconfig.base.json",
  "include": ["scripts/**/*.ts", "src/cli/contract.ts"],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "./.scripts-types",
    "rootDir": ".",
    "tsBuildInfoFile": "./.scripts-types/tsconfig.scripts.tsbuildinfo",
    // Resolve @distilled.cloud/core/* to src (the bun condition), matching
    // how the scripts actually run (node --conditions=bun).
    "rewriteRelativeImportExtensions": false,
    "customConditions": ["bun"]
  },
  "references": [{ "path": "../core" }, { "path": "../dev" }]
}
